APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Versity League: use MySQL (XAMPP). Create database `versity_league` in phpMyAdmin first.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=versity_league
DB_USERNAME=root
DB_PASSWORD=

# Optional: sqlite for quick tests — comment MySQL above and uncomment:
# DB_CONNECTION=sqlite
# # DB_DATABASE=... (leave empty; uses database/database.sqlite)

# Comma-separated browser origins allowed to call the API (CORS). Use * for local-only experiments.
# Include every origin you use to open the frontend (scheme + host + port). Examples: Live Server 5500, PHP -S 8080, XAMPP.
# config/cors.php also allows http(s)://localhost and http(s)://127.0.0.1 with any port via allowed_origins_patterns.
FRONTEND_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8000,http://localhost:8000,http://localhost:8080,http://127.0.0.1:8080

# Seeded main admin (Day 1). Change password before any shared environment.
MAIN_ADMIN_USERNAME=admin
MAIN_ADMIN_NAME="Main Administrator"
MAIN_ADMIN_EMAIL=admin@versityleague.local
MAIN_ADMIN_PASSWORD=ChangeMeNow!

# Google reCAPTCHA v2 (checkbox). Site key is public — also set in frontend <meta name="recaptcha-site-key">.
RECAPTCHA_SECRET_KEY=
# Local dev without keys: set true (never in production).
RECAPTCHA_SKIP_VERIFY=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
