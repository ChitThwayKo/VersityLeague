APP_NAME="Versity League"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Must match how you open Laravel in the browser (including port and `/backend/public` on XAMPP).
# Wrong APP_URL breaks Storage URLs (gallery/club logos) — they embed this host. Example XAMPP:
# APP_URL=http://localhost:8080/VersityLeague_V4_D9/backend/public
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
# If XAMPP shows MySQL on another port (e.g. 3307), set DB_PORT to match.
DB_PORT=3306
DB_DATABASE=versity_league
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Rare: set true only if you rely on Laravel's private-disk HTTP `storage/{path}` routes (not used by Versity gallery).
# FILESYSTEM_LOCAL_SERVE=true
# After clone or deploy: from backend/, run `php artisan storage:link` so `public/storage` points at `storage/app/public` (uploads at /storage/...). If `storage:link` says the link "already exists" but images still 403, `public/storage` may be an empty real folder — delete that folder, then run `storage:link` again (Windows uses a junction).
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Seeded default administrator (see database/seeders/DefaultAdminSeeder.php)
DEFAULT_ADMIN_NAME="Default Administrator"
DEFAULT_ADMIN_EMAIL=default-admin@versity-league.local
DEFAULT_ADMIN_STUDENT_STAFF_ID=VERSITY-DEFAULT-ADMIN
DEFAULT_ADMIN_PASSWORD=password
